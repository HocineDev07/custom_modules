<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_report_hello_wizard_form" model="ir.ui.view">
        <field name="name">report.hello.wizard.form</field>
        <field name="model">report.hello.wizard</field>
        <field name="arch" type="xml">
            <form string="Hello Wizard">
                <sheet>
                    <group>
                        <field name="message" readonly="1"/>
                    </group>
                    <footer>
                        <button string="OK" class="oe_highlight" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_report_hello_wizard" model="ir.actions.act_window">
        <field name="name">Hello Wizard</field>
        <field name="res_model">report.hello.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_report_hello_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
