<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_wizard_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.inherit.sale.wizard</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//button[@name='action_cancel']" position="after">
                    <button type="object" name="open_wizard" string="Open Wizard">
                    </button>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
