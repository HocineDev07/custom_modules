<odoo>
    <data>
        <!-- Define the form view for the wizard -->
        <record id="view_print_wizard_form" model="ir.ui.view">
            <field name="name">print.wizard.form</field>
            <field name="model">print.wizard</field>
            <field name="arch" type="xml">
                <form string="Print Wizard">
                    <group>
                        <field name="message"/>
                    </group>
                    <footer>
                        <button string="Close" class="btn-primary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define the action for the wizard -->
        <record id="action_print_wizard" model="ir.actions.act_window">
            <field name="name">Print Wizard</field>
            <field name="res_model">print.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_print_wizard_form"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
