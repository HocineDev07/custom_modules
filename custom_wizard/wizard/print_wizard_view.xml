<!-- views/print_wizard_view.xml -->
<odoo>
    <record id="print_wizard_form_view" model="ir.ui.view">
        <field name="name">print.wizard.form</field>
        <field name="model">print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Wizard">
                <group>
                    <field name="message"/>
                </group>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
