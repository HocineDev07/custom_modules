<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sql_execution_form" model="ir.ui.view">
        <field name="name">sql.execution.form</field>
        <field name="model">sql.execution</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="model_id"/>
                        </group>
                        <group>
                            <field name="technical_name"/>
                        </group>
                    </group>
                    <group>
                        <field name="sql_expression" widget="ace" options="{'mode': 'python'}" class="large_font_size"/>
                    </group>
                    <group>
                        <button name="compute_result" type="object" string=" Execute" class="oe_highlight fa fa-play"/>
                        <button name="clear_result" type="object" string=" Clear" class="fa fa-refresh"/>
                    </group>
                    <group>
                        <div class="label-above">
                            <div class="o_form_label">Result:</div>
                            <div class="content">
                                <field name="result" widget="html"/>
                            </div>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sql_execution" model="ir.actions.act_window">
        <field name="name">SQL Execution</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sql.execution</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
    </record>


    <menuitem id="menu_sql_execution"
              name="SQL Execution"
              parent="menu_orm_execution_root"
              action="action_sql_execution"
              sequence="2"/>

</odoo>