<odoo>
    <record id="view_pdf_viewer_form" model="ir.ui.view">
        <field name="name">pdf.viewer.form</field>
        <field name="model">pdf.viewer</field>
        <field name="arch" type="xml">
            <form string="PDF Viewer">
                <group>
                    <field name="pdf_view" widget="pdf_viewer" filename="name" />
                </group>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

